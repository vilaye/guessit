<Window x:Class="GuessIt.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GuessIt.App.ViewModels"
        xmlns:converters="clr-namespace:GuessIt.App.Converters"
        Title="GuessIt" Height="600" Width="450"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6FA">

    <Window.DataContext>
        <vm:GameViewModel />
    </Window.DataContext>

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.1" />
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <StackPanel>
            <!-- Header -->
            <TextBlock Text="GuessIt"
                       FontSize="28" FontWeight="Bold"
                       Foreground="#2C3E50"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20" />

            <!-- Schwierigkeit + Stats -->
            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Schwierigkeit" FontSize="11"
                                   Foreground="#95A5A6" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding Difficulties}"
                                  SelectedIndex="{Binding SelectedDifficultyIndex}"
                                  FontSize="13" Padding="6,4" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="20,0,0,0"
                                VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Versuche" FontSize="11"
                                   Foreground="#95A5A6" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding AttemptCount}" FontSize="24"
                                   FontWeight="Bold" Foreground="#2C3E50"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="20,0,0,0"
                                VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Zeit" FontSize="11"
                                   Foreground="#95A5A6" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding ElapsedTime}" FontSize="24"
                                   FontWeight="Bold" Foreground="#2C3E50"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Eingabe -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="{Binding FeedbackMessage}"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{Binding FeedbackColor}"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,16" />

                    <!-- Eingabefeld + Button -->
                    <Grid Visibility="{Binding IsGameOver, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="GuessTextBox"
                                 Grid.Column="0"
                                 Text="{Binding GuessInput, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="18" Padding="10,8"
                                 VerticalContentAlignment="Center"
                                 MaxLength="3">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return"
                                            Command="{Binding GuessCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>

                        <Button Grid.Column="1"
                                Content="Raten"
                                Command="{Binding GuessCommand}"
                                FontSize="14" FontWeight="SemiBold"
                                Padding="20,8"
                                Margin="8,0,0,0"
                                Background="#3498DB"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand" />
                    </Grid>

                    <!-- Neues Spiel Button -->
                    <Button Content="Neues Spiel starten"
                            Command="{Binding NewGameCommand}"
                            Visibility="{Binding IsGameOver, Converter={StaticResource BoolToVisibility}}"
                            FontSize="16" FontWeight="SemiBold"
                            Padding="20,12"
                            Background="#27AE60"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            HorizontalAlignment="Stretch" />
                </StackPanel>
            </Border>

            <!-- Verlauf -->
            <Border Style="{StaticResource CardStyle}"
                    MaxHeight="200">
                <StackPanel>
                    <TextBlock Text="Verlauf" FontSize="11"
                               Foreground="#95A5A6" Margin="0,0,0,8" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  MaxHeight="150">
                        <TextBlock Text="{Binding GuessHistory}"
                                   FontSize="13" Foreground="#2C3E50"
                                   TextWrapping="Wrap"
                                   FontFamily="Consolas" />
                    </ScrollViewer>
                </StackPanel>
            </Border>

        </StackPanel>

        <!-- API-Status (fixiert unten rechts) -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,4,0">
            <Ellipse Width="10" Height="10"
                     Fill="{Binding ApiStatusColor}"
                     VerticalAlignment="Center"
                     Margin="0,0,8,0" />
            <TextBlock Text="{Binding ApiStatusText}"
                       FontSize="13" Foreground="#95A5A6" />
        </StackPanel>
    </Grid>
</Window>
